{
  "name": "stratscope",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "description": "AI Execution Intelligence Platform — The Operating System for Production AI",
  "scripts": {
    "dev": "pnpm --filter @stratscope/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @stratscope/api db:migrate",
    "db:generate": "pnpm --filter @stratscope/api db:generate",
    "deploy": "pnpm --filter @stratscope/api deploy",
    "preview": "pnpm --filter @stratscope/api preview",
    "seea:dev": "pnpm --filter @stratscope/seea dev",
    "seea:start": "pnpm --filter @stratscope/seea start",
    "seea:test": "pnpm --filter @stratscope/seea test",
    "seea:typecheck": "pnpm --filter @stratscope/seea typecheck",
    "test:integration:run": "vitest run tests/integration.test.ts",
    "test:all": "pnpm test && pnpm --filter @stratscope/seea test"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "turbo": "^2.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
