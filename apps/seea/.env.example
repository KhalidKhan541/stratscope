# StratScope API base URL (live deployment)
# Defaults to https://stratscope-api.khalidkhan.workers.dev if unset.
STRATSCOPE_API_URL=https://stratscope-api.khalidkhan.workers.dev

# StratScope API key (required)
# Create one in the StratScope dashboard -> API Keys, or use the
# STRATSCOPE_API_KEY secret configured on the GitHub repository.
STRATSCOPE_API_KEY=your_api_key

# StratScope project and organization IDs (required)
# Found in the StratScope dashboard URL after logging in.
STRATSCOPE_PROJECT_ID=your_project_id
STRATSCOPE_ORG_ID=your_org_id

# Agent ID registered with StratScope (used to attribute executions)
STRATSCOPE_AGENT_ID=seea-agent

# Groq API key (required for LLM calls)
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# LLM model to use (defaults to llama-3.3-70b-versatile on Groq)
# Override per-run via the STRATSCOPE_MODEL secret in GitHub Actions.
MODEL=llama-3.3-70b-versatile

# Working directory for the agent (datasets/ and logs/ are written here)
SEE_WORKSPACE=./workspace

# Maximum execution iterations before the agent stops (default 5)
MAX_ITERATIONS=5

# Optional task type filter (e.g. bugfix, feature). Empty = no filter.
TASK_TYPE=
